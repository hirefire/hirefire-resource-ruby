#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "prism"
require_relative "../lib/results"

root = File.expand_path("../..", __dir__)
records = File.readlines(Audit.results("mutation/mutants.jsonl")).map { |line| JSON.parse(line) }
alive = records.select { |record| %w[survived uncovered].include?(record["status"]) }

class Methods < Prism::Visitor
  attr_reader :ranges

  def initialize
    super
    @ranges = []
  end

  def visit_def_node(node)
    @ranges << [node.location.start_line, node.location.end_line, node.name.to_s]
    super
  end
end

methods = Hash.new do |hash, file|
  visitor = Methods.new
  visitor.visit(Prism.parse_file(File.join(root, file)).value)
  hash[file] = visitor.ranges
end
enclosing = lambda do |record|
  range = methods[record["file"]].select { |first, last, _| record["line"].between?(first, last) }.min_by { |first, last, _| last - first }
  range ? range[2] : "(top level)"
end

file = ->(name) { "lib/hirefire/#{name}.rb" }
within = ->(record, name, lines) { record["file"] == file.call(name) && lines.cover?(record["line"]) }

RAILTIE = "The Railtie is the least tested file"
QUEUE_CLASSIC = "The Queue Classic path without ActiveRecord never runs"
DEAD = "Dead code"
UNSUPPORTED = "Code for library versions that are no longer supported"
SEAMS = "The library carries code that only its tests call"
UNRUN = "Lines that no test runs"
LOGS = "Log lines and once-only warnings are not asserted"
LIMITS = "Limits and defaults are not pinned by a test"
LIFECYCLE = "No test pins the state changes of start, stop, and abandon"
LEASE = "Lease rules without a test"
DISPATCH = "Dispatch rules without a test"
ADAPTERS = "Adapter branches without a test"
GUARDS = "Guards and fallbacks in the core that no test contradicts"

rules = [
  ["railtie", :finding, RAILTIE, "the Railtie's middleware check and boot", ->(record, _) { record["file"] == file.call("railtie") }],
  ["queue-classic-direct", :finding, QUEUE_CLASSIC, "the query path without ActiveRecord", ->(record, _) { within.call(record, "macro/queue_classic", 73..94) }],
  ["dead-code", :finding, DEAD, "code that cannot run or has no caller", lambda do |record, name|
    within.call(record, "dispatcher", 554..560) || within.call(record, "dispatcher", 571..579) || within.call(record, "buffer", 77..86) ||
      within.call(record, "macro/sidekiq/due_cache", 385..402) || (record["file"] == file.call("plan") && name == "sample_job_strategy" && %w[boolean return_nil].include?(record["kind"])) ||
      (record["file"] == file.call("source/job_queues") && name == "configuration") || (record["file"] == file.call("configuration") && name == "register")
  end],
  ["unsupported-versions", :finding, UNSUPPORTED, "Que 0 and Sidekiq 6 paths and their version switches", lambda do |record, name|
    (record["file"] == file.call("macro/que") && (name.end_with?("_v0") || %w[job_queue_latency job_queue_size job_queue_working advisory_lock_id_column version query_job_queue_latency].include?(name))) ||
      (record["file"] == file.call("macro/sidekiq") && %w[server_lookup count_with_redis].include?(name)) ||
      (record["file"] == file.call("macro/sidekiq/due_cache") && %w[zrange_first_with_score zrange_batch].include?(name)) ||
      (record["file"] == file.call("macro/helpers/good_job") && name == "good_job_class")
  end],
  ["test-seams", :finding, SEAMS, "methods that only tests call", ->(record, name) { record["file"] == file.call("macro/sidekiq/due_cache") && %w[clear_all peek sample_active?].include?(name) }],
  ["nil-initializers", :equivalent, nil, "the deleted line sets an instance variable to nil or false in `initialize`, and an unset instance variable reads nil, which every reader treats the same", ->(record, name) { name == "initialize" && record["kind"] == "delete_statement" && record["original"].match?(/= (nil|false)\z/) }],
  ["unrun", :finding, UNRUN, "lines outside the groups above that no cell runs", ->(record, _) { record["status"] == "uncovered" }],
  ["logs", :finding, LOGS, "a log call, its message, or a once-only flag", lambda do |record, name|
    name.start_with?("warn_") || %w[remember_warn log_to drop_oversized_payload].include?(name) || record["original"].match?(/Log\.safe|format_error|\.message\b|logger/)
  end],
  ["limits", :finding, LIMITS, "a numeric constant or default", ->(record, _) { %w[integer float].include?(record["kind"]) }],
  ["lifecycle", :finding, LIFECYCLE, "start, stop, the loop checks, and the fork paths", lambda do |record, _|
    within.call(record, "dispatcher", 16..260) || record["file"] == file.call("hirefire")
  end],
  ["lease", :finding, LEASE, "the lease state machine and the grant parser", ->(record, _) { record["file"] == file.call("lease") }],
  ["dispatch", :finding, DISPATCH, "plan routing, the flush, and the payload", ->(record, _) { record["file"] == file.call("dispatcher") }],
  ["adapters", :finding, ADAPTERS, "the macros and their helpers", ->(record, _) { record["file"].start_with?("lib/hirefire/macro/") }],
  ["guards", :finding, GUARDS, "every other core file", ->(_record, _) { true }]
]

groups = rules.map { |id, verdict, finding, cause, _| {id: id, verdict: verdict, finding: finding, cause: cause, mutants: []} }
alive.each do |record|
  name = enclosing.call(record)
  index = rules.index { |_, _, _, _, test| test.call(record, name) }
  groups[index][:mutants] << {id: record["id"], at: "#{record["file"]}:#{record["line"]}", method: name, kind: record["kind"], status: record["status"]}
end

output = {
  alive: alive.size,
  groups: groups.map do |group|
    files = group[:mutants].map { |mutant| mutant[:at].split(":").first.delete_prefix("lib/hirefire/") }.tally.sort_by { |_, count| -count }
    group.merge(count: group[:mutants].size, files: files.to_h)
  end
}
File.write(Audit.results("mutation/triage.json"), JSON.pretty_generate(output) + "\n")

output[:groups].each do |group|
  target = (group[:verdict] == :equivalent) ? "equivalent" : group[:finding]
  puts format("%-22s %4d  %-58s %s", group[:id], group[:count], target, group[:files].first(4).map { |name, count| "#{name}=#{count}" }.join(" "))
end
puts "#{alive.size} alive, #{output[:groups].sum { |group| group[:count] }} assigned"

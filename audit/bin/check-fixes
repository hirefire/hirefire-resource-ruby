#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

USAGE = "usage: check-fixes PATH_TO_CANON_RUBY_AUDIT_DIRECTORY [--refresh]"
STATUSES = %w[fixed closed server].freeze

def git(directory, *arguments)
  output, status = Open3.capture2e("git", "-C", directory, *arguments)
  status.success? ? output.strip : nil
end

def on_head?(repository, hash)
  !git(repository, "merge-base", "--is-ancestor", hash, "HEAD").nil?
end

def successor(repository, hash)
  subject = git(repository, "log", "-1", "--format=%s", hash) or return
  matches = git(repository, "log", "--format=%h %s", "HEAD").lines.map(&:chomp).select { |line| line.split(" ", 2).last == subject }
  matches.first.split.first if matches.size == 1
end

root = File.expand_path("../..", __dir__)
directory = ARGV.find { |argument| !argument.start_with?("--") } or abort(USAGE)
path = File.join(directory, "fixes.md")
canon = git(directory, "rev-parse", "--show-toplevel") or abort("#{directory} is not in a git repository")
cutover = File.read(File.join(directory, "../2.0-cutover.md"))
text = File.read(path)

if ARGV.include?("--refresh")
  replaced = 0
  text = text.lines.map do |line|
    next line unless line.match?(/\A\| F-\d\d /)

    line.gsub(/((?:canon|Canon) )?`(\h{7,40})`/) do
      prefix, hash = Regexp.last_match(1), Regexp.last_match(2)
      repository = prefix ? canon : root
      next Regexp.last_match(0) if on_head?(repository, hash)

      fresh = successor(repository, hash) or next Regexp.last_match(0)
      replaced += 1
      "#{prefix}`#{fresh}`"
    end
  end.join
  File.write(path, text)
  puts "refreshed #{replaced} commit hashes in #{path}"
end

rows = text.lines.filter_map do |line|
  cells = line.split("|").map(&:strip)
  {id: cells[1], status: cells[4], commits: cells[5], note: cells[6]} if cells[1]&.match?(/\AF-\d\d\z/)
end

problems = []
expected = (1..60).map { |number| format("F-%02d", number) }
problems << "the table lists #{rows.size} findings, not 60" unless rows.map { |row| row[:id] } == expected

rows.each do |row|
  id = row[:id]
  unless STATUSES.include?(row[:status])
    problems << "#{id}: status #{row[:status].inspect} is not fixed, closed, or server"
    next
  end

  commits = row[:commits].scan(/(canon )?`(\h{7,40})`/).map { |prefix, hash| [prefix ? canon : root, hash] }
  commits += row[:note].scan(/Canon `(\h{7,40})`/).map { |(hash)| [canon, hash] }
  commits.each do |repository, hash|
    problems << "#{id}: commit #{hash} is not on HEAD of #{File.basename(File.dirname(repository))}/#{File.basename(repository)}" unless on_head?(repository, hash)
  end
  named = commits.any? { |repository, hash| git(repository, "log", "-1", "--format=%B", hash).to_s.match?(/\b#{id}\b/) }

  case row[:status]
  when "fixed"
    problems << "#{id}: fixed without a commit" if commits.empty?
    problems << "#{id}: no listed commit names the finding in its message" if commits.any? && !named
  when "closed"
    problems << "#{id}: closed without a reason" if row[:note].empty?
  when "server"
    problems << "#{id}: no commit for the client half" if commits.empty?
    problems << "#{id}: no listed commit names the finding in its message" if commits.any? && !named
    problems << "#{id}: the note does not say what the server half is" unless row[:note].match?(/server half/i)
    problems << "#{id}: no item in 2.0-cutover.md names it" unless cutover.match?(/^- \[[ x]\] .*\b#{id}\b/)
  end
end

counts = rows.map { |row| row[:status] }.tally
puts format("%d findings: %d fixed, %d closed, %d waiting on the server", rows.size, counts["fixed"].to_i, counts["closed"].to_i, counts["server"].to_i)
problems.each { |problem| puts "FAIL #{problem}" }
puts "PASS every finding is fixed with its commit, closed with its reason, or waiting on the server" if problems.empty?
exit(problems.empty? ? 0 : 1)

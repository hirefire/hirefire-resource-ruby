#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler"
require "fileutils"
require "open3"
require "tmpdir"
require_relative "../lib/wire_scenarios"

root = File.expand_path("../..", __dir__)
check = ARGV.delete("--check")
directory = File.join(root, "tools/baseline/wire")
FileUtils.mkdir_p(directory)
abort "set TOOLS_REDIS_URL to a Redis that this script may flush" unless ENV["TOOLS_REDIS_URL"]

failed = []
Dir.mktmpdir("wire-goldens") do |scratch|
  Tools::WireScenarios::GEMFILES.each do |name, cell|
    env = {"BUNDLE_GEMFILE" => File.join(root, "gemfiles/#{cell}.gemfile"), "COVERAGE" => "false"}
    fresh = File.join(scratch, "#{name}.json")
    command = ["bundle", "exec", "ruby", "-Ilib", "-r", File.join(root, "tools/lib/wire_scenarios"), "-e", "Tools::WireScenarios.run(*ARGV)", name, fresh]
    _output, error, status = Bundler.with_unbundled_env { Open3.capture3(env, *command, chdir: root) }
    unless status.success? && File.exist?(fresh)
      failed << name
      puts "FAIL #{name}: #{error.lines.last(3).join.strip}"
      next
    end

    path = File.join(directory, "#{name}.json")
    if check
      same = File.exist?(path) && File.read(path) == File.read(fresh)
      failed << name unless same
      puts "#{same ? "same" : "DIFF"} #{name}"
    else
      FileUtils.cp(fresh, path)
      puts "wrote #{name}"
    end
  end
end

exit(failed.empty? ? 0 : 1)

#!/usr/bin/env ruby
# frozen_string_literal: true

# Assert the built gem ships LICENSE, README, and CHANGELOG.
#
# Run after `rake build`. Used by GitHub Actions `check` and `publish`.
# Selects the gem for HireFire::VERSION so leftover pkg/ files from older
# versions are ignored.

require "rubygems/package"
require_relative "../lib/hirefire/version"

root = File.expand_path("..", __dir__)
pkg = File.join(root, "pkg")
abort "no pkg/; run rake build first" unless Dir.exist?(pkg)

version = HireFire::VERSION
gems = Dir[File.join(pkg, "hirefire-resource-#{version}*.gem")]
abort "no gem for #{version} in pkg/" if gems.empty?

path = gems.max_by { |gem| File.mtime(gem) }
names = Gem::Package.new(path).contents

%w[LICENSE README.md CHANGELOG.md].each do |name|
  abort "gem missing #{name}" unless names.include?(name)
end

puts "gem ok: #{File.basename(path)}"

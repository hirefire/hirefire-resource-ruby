#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"

ROOT = File.expand_path("../..", __dir__)
RUN = ENV.fetch("AUDIT_RUN", "fixes")

def load(*parts)
  JSON.parse(File.read(File.join(ROOT, "audit/results", *parts)))
end

def pair(before, after)
  format("%9s %9s", before.nil? ? "n/a" : before, after.nil? ? "n/a" : after)
end

audit_faults = load("faults/results.json").to_h { |result| [result["scenario"], result] }
fixes_faults = load(RUN, "faults/results.json").to_h { |result| [result["scenario"], result] }
columns = {
  "escaped" => ->(result) { result["escaped"].size },
  "slowest ms" => ->(result) { result["middleware_max_ms"] },
  "ingest" => ->(result) { result["ingest_requests"] },
  "lease" => ->(result) { result["lease_requests"] },
  "log/min" => ->(result) { result["log_lines_per_minute"] },
  "recovered s" => ->(result) { result["recovered_after_seconds"] },
  "stop s" => ->(result) { result["stop_seconds_under_fault"] }
}

puts "Fault runs: each pair is the audit (4787942) and then this branch"
puts "fault".ljust(18) + columns.keys.map { |name| format(" %19s", name) }.join
audit_faults.each do |scenario, before|
  after = fixes_faults[scenario]
  abort "no run of #{scenario} on this branch" unless after

  puts format("%-18s", scenario) + columns.values.map { |read| " " + pair(read.call(before), read.call(after)) }.join
end
extra = fixes_faults.keys - audit_faults.keys
puts "only on this branch: #{extra.join(", ")}" if extra.any?
[["exceptions that reached the host", ->(list) { list.sum { |result| result["escaped"].size } }],
  ["slowest middleware call (ms)", ->(list) { list.map { |result| result["middleware_max_ms"] }.max }],
  ["dispatcher running after every fault", ->(list) { list.all? { |result| result["dispatcher_running_after_fault"] } }],
  ["threads after a fault", ->(list) { list.map { |result| result["threads_after_fault"] }.uniq.sort.join(" or ") }],
  ["threads after stop", ->(list) { list.map { |result| result["threads_after_stop"] }.uniq.sort.join(" or ") }],
  ["slowest recovery (s)", ->(list) { list.filter_map { |result| result["recovered_after_seconds"] }.max }],
  ["slowest stop under a fault (s)", ->(list) { list.map { |result| result["stop_seconds_under_fault"] }.max }]].each do |label, read|
  puts format("%-38s %s", label, pair(read.call(audit_faults.values), read.call(fixes_faults.values)))
end

audit_soak = load("soak/soak.json")
fixes_soak = load(RUN, "soak/soak.json")
puts
puts "Soak: the audit (4787942) and then this branch"
rows = [
  ["minutes", ->(soak) { (soak["seconds"] / 60.0).round(1) }],
  ["RSS first (kB)", ->(soak) { soak["rss_kb"]["first"] }],
  ["RSS last (kB)", ->(soak) { soak["rss_kb"]["last"] }],
  ["RSS highest (kB)", ->(soak) { soak["rss_kb"]["max"] }],
  ["RSS kB per minute, last two thirds", ->(soak) { soak["rss_growth_kb_per_minute_last_two_thirds"] }],
  ["live heap slots first", ->(soak) { soak["heap_live_slots"]["first"] }],
  ["live heap slots last", ->(soak) { soak["heap_live_slots"]["last"] }],
  ["threads lowest", ->(soak) { soak["threads"]["min"] }],
  ["threads highest", ->(soak) { soak["threads"]["max"] }],
  ["file descriptors lowest", ->(soak) { soak["fds"]["min"] }],
  ["file descriptors highest", ->(soak) { soak["fds"]["max"] }],
  ["server sockets highest", ->(soak) { soak["server_open_sockets"]["max"] }],
  ["connections accepted", ->(soak) { soak["connections_accepted"] }],
  ["requests", ->(soak) { soak["requests"] }],
  ["ingest requests", ->(soak) { soak["requests_by_path"]["/metrics/ingest"] }],
  ["lease requests", ->(soak) { soak["requests_by_path"]["/metrics/lease"] }],
  ["middleware calls", ->(soak) { soak["middleware_calls"] }],
  ["slowest middleware call (ms)", ->(soak) { soak["middleware_max_ms"] }],
  ["exceptions that reached the host", ->(soak) { soak["escaped"].size }],
  ["forks", ->(soak) { soak["forks"] }],
  ["slowest fork (s)", ->(soak) { soak["fork_seconds_max"] }],
  ["slowest restart after a fork (s)", ->(soak) { soak["restart_seconds_max"] }],
  ["log lines", ->(soak) { soak["log_lines"] }],
  ["stop (s)", ->(soak) { soak["stop_seconds"] }],
  ["threads after stop", ->(soak) { soak["after_stop"]["threads"] }],
  ["client threads gone after (s)", ->(soak) { soak["client_threads_gone_seconds"] }],
  ["threads left after stop", ->(soak) { soak["after_stop"]["thread_names"]&.join(", ") }],
  ["file descriptors after stop", ->(soak) { soak["after_stop"]["fds"] }],
  ["server sockets after stop", ->(soak) { soak["after_stop"]["server_open_sockets"] }]
]
rows.each { |label, read| puts format("%-38s %s", label, pair(read.call(audit_soak), read.call(fixes_soak))) }

#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler"
require "fileutils"
require "json"
require "optparse"
require_relative "../lib/fault_harness"
require_relative "../lib/results"

root = File.expand_path("../..", __dir__)
options = {fault: 20, heal: 12, parallel: 5, only: nil}
OptionParser.new do |opts|
  opts.on("--fault SECONDS", Integer) { |seconds| options[:fault] = seconds }
  opts.on("--heal SECONDS", Integer) { |seconds| options[:heal] = seconds }
  opts.on("--parallel N", Integer) { |count| options[:parallel] = count }
  opts.on("--only LIST") { |list| options[:only] = list.split(",") }
end.parse!

directory = Tools.results("faults")
FileUtils.mkdir_p(directory)
scenarios = options[:only] || Tools::FaultHarness::SCENARIOS
script = "File.write(ARGV[1], JSON.pretty_generate(Tools::FaultHarness.new(ARGV[0], fault_seconds: #{options[:fault]}, heal_seconds: #{options[:heal]}).run) + \"\\n\")"
env = {"BUNDLE_GEMFILE" => File.join(root, "gemfiles/default.gemfile"), "COVERAGE" => "false"}

scenarios.each_slice(options[:parallel]) do |group|
  pids = group.map do |scenario|
    path = File.join(directory, "#{scenario}.json")
    FileUtils.rm_f(path)
    command = ["bundle", "exec", "ruby", "-Ilib", "-r", File.join(root, "tools/lib/fault_harness"), "-e", script, scenario, path]
    Bundler.with_unbundled_env { Process.spawn(env, *command, chdir: root, out: File.join(directory, "#{scenario}.log"), err: [:child, :out]) }
  end
  pids.each { |pid| Process.wait(pid) }
end

results = scenarios.filter_map do |scenario|
  path = File.join(directory, "#{scenario}.json")
  File.exist?(path) ? JSON.parse(File.read(path)) : {"scenario" => scenario, "crashed" => true}
end
File.write(File.join(directory, "results.json"), JSON.pretty_generate(results) + "\n")

puts "scenario            escaped  mw max ms  ingest  lease  log/min  running  threads  recover s  stop s"
results.each do |result|
  if result["crashed"]
    puts format("%-19s harness crashed, see tools/results/faults/%s.log", result["scenario"], result["scenario"])
    next
  end
  puts format(
    "%-19s %7d %10.2f %7d %6d %8d  %-7s %3d>%-3d %10s %7.2f",
    result["scenario"], result["escaped"].size, result["middleware_max_ms"], result["ingest_requests"], result["lease_requests"],
    result["log_lines_per_minute"], result["dispatcher_running_after_fault"].inspect, result["threads_start"], result["threads_after_fault"],
    result["recovered_after_seconds"] || "n/a", result["stop_seconds_under_fault"]
  )
end

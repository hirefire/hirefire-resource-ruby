#!/usr/bin/env ruby
# frozen_string_literal: true

require "bundler/setup"
require "digest"
require "json"
require "rails" if Gem.loaded_specs.key?("railties")
$LOAD_PATH.unshift(ENV["TOOLS_LIB"]) if ENV["TOOLS_LIB"]
require "hirefire-resource"
require_relative "../lib/results"

OWNED = Hash.new { |owned, owner| owned[owner] = [] }

def signature(method)
  method.parameters.map do |kind, name|
    case kind
    when :req then name.to_s
    when :opt then "#{name} = ?"
    when :rest then "*#{name}"
    when :keyreq then "#{name}:"
    when :key then "#{name}: ?"
    when :keyrest then "**#{name}"
    when :block then "&#{name}"
    else kind.to_s
    end
  end.join(", ")
end

def summarize(value)
  text = value.inspect
  return text if text.bytesize <= 120

  "#{value.class} (#{text.bytesize} bytes, sha256 #{Digest::SHA256.hexdigest(text)[0, 12]})"
end

def describe(mod, lines)
  kind = mod.is_a?(Class) ? "class" : "module"
  parent = (mod.is_a?(Class) && mod.superclass != Object) ? " < #{mod.superclass}" : ""
  lines << "#{kind} #{mod.name}#{parent}"

  (mod.singleton_methods - Module.instance_methods).sort.each do |name|
    method = mod.method(name)
    next unless method.owner.inspect.include?("HireFire")

    lines << "  .#{name}(#{signature(method)}) [#{method.owner.inspect.sub(/#<Class:(.*)>/, '\1')}]"
  end

  mod.public_instance_methods(false).sort.each do |name|
    lines << "  ##{name}(#{signature(mod.instance_method(name))})"
  end
end

def walk(mod, seen, lines)
  return if seen.include?(mod)

  seen << mod
  first = lines.size + 1
  describe(mod, lines)
  OWNED[mod.name].concat(lines[first..].map(&:strip))
  mod.constants(false).sort.each do |name|
    value = mod.const_get(name)
    if value.is_a?(Module)
      OWNED[mod.name] << "#{name} -> #{value.name}" unless value.name == "#{mod.name}::#{name}"
      walk(value, seen, lines) if value.name.to_s.start_with?("HireFire")
    else
      lines << "  #{name} = #{summarize(value)}"
      OWNED[mod.name] << lines.last.strip
    end
  end
end

lines = []
walk(HireFire, [], lines)

root = File.expand_path("../..", __dir__)
path = ENV["TOOLS_API_OUT"] || (ENV["TOOLS_RUN"] ? Tools.results("public_api.txt") : File.join(root, "tools/baseline/public_api.txt"))
header = [
  "commit #{`git -C #{root} rev-parse HEAD`.strip}",
  "gemfile #{File.basename(ENV.fetch("BUNDLE_GEMFILE"))}",
  ""
]
File.write(path, (header + lines).join("\n") + "\n")
File.write(path.sub(/\.txt\z/, ".json"), JSON.pretty_generate(OWNED) + "\n") if ENV["TOOLS_API_OUT"] || ENV["TOOLS_RUN"]
puts "#{lines.count { |line| line.start_with?("class ", "module ") }} modules and classes, #{lines.count { |line| line.start_with?("  .", "  #") }} methods, #{lines.count { |line| line.match?(/\A  [A-Z]/) }} constants -> #{path}"

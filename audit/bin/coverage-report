#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require "simplecov"
require_relative "../lib/results"

root = File.expand_path("../..", __dir__)
Dir.chdir(root)

resultsets = Dir[Audit.results("coverage/cells/*/.resultset.json")].sort
abort "no coverage results under audit/results/coverage/cells" if resultsets.empty?

SimpleCov.configure do
  root root
  coverage_dir Audit.results("coverage/merged")
  enable_coverage :branch
  primary_coverage :line
  filters.clear
  add_filter { |source| !source.filename.start_with?(File.join(root, "lib/")) }
  formatter Class.new { define_method(:format) { |_result| nil } }
end

result = SimpleCov::ResultMerger.merge_and_store(*resultsets, ignore_timeout: true)

cells_by_line = Hash.new { |hash, file| hash[file] = Hash.new { |lines, line| lines[line] = [] } }
relevant_lines = Hash.new { |hash, file| hash[file] = [] }
resultsets.each do |path|
  JSON.parse(File.read(path)).each do |command, data|
    cell = command.sub(/-child-\h+\z/, "")
    data.fetch("coverage").each do |file, coverage|
      relative = file.delete_prefix("#{root}/")
      next unless relative.start_with?("lib/")

      coverage.fetch("lines").each_with_index do |hits, index|
        relevant_lines[relative] << index + 1 unless hits.nil?
        cells_by_line[relative][index + 1] << cell if hits.to_i > 0
      end
    end
  end
end

files = result.files.sort_by(&:filename).map do |file|
  relative = file.filename.delete_prefix("#{root}/")
  {
    file: relative,
    lines: file.lines_of_code,
    lines_covered: file.covered_lines.size,
    line_percent: file.covered_percent.round(2),
    missed_lines: file.missed_lines.map(&:line_number),
    branches: file.total_branches.size,
    branches_covered: file.covered_branches.size,
    branch_percent: file.total_branches.empty? ? 100.0 : file.branches_coverage_percent.round(2),
    missed_branches: file.missed_branches.map { |branch| {line: branch.report_line, type: branch.type} },
    cells: cells_by_line[relative].values.flatten.uniq.sort
  }
end

totals = {
  files: files.size,
  lines: files.sum { |file| file[:lines] },
  lines_covered: files.sum { |file| file[:lines_covered] },
  branches: files.sum { |file| file[:branches] },
  branches_covered: files.sum { |file| file[:branches_covered] }
}
totals[:line_percent] = (totals[:lines_covered] * 100.0 / totals[:lines]).round(2)
totals[:branch_percent] = (totals[:branches_covered] * 100.0 / totals[:branches]).round(2)

output = {
  commit: `git rev-parse HEAD`.strip,
  ruby: RUBY_DESCRIPTION,
  cells: resultsets.map { |path| File.basename(File.dirname(path)) },
  totals: totals,
  files: files,
  line_cells: cells_by_line.transform_values { |lines| lines.sort.to_h },
  relevant_lines: relevant_lines.transform_values { |lines| lines.uniq.sort }
}
FileUtils.mkdir_p(File.dirname(Audit.coverage_file))
File.write(Audit.coverage_file, JSON.generate(output) + "\n")

puts "file                                              lines   line % branches branch %    missed"
files.each do |file|
  puts format("%-48s %6d %8.2f %8d %8.2f %9s", file[:file], file[:lines], file[:line_percent], file[:branches], file[:branch_percent], "#{file[:missed_lines].size}/#{file[:missed_branches].size}")
end
puts format("%-48s %6d %8.2f %8d %8.2f", "TOTAL (#{totals[:files]} files, #{output[:cells].size} cells)", totals[:lines], totals[:line_percent], totals[:branches], totals[:branch_percent])

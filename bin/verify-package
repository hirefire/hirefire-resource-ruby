#!/usr/bin/env ruby
# frozen_string_literal: true

require "rubygems/package"
require_relative "../lib/hirefire/version"

root = File.expand_path("..", __dir__)
pkg = File.join(root, "pkg")
abort "no pkg/; run rake build first" unless Dir.exist?(pkg)

version = HireFire::VERSION
path = File.join(pkg, "hirefire-resource-#{version}.gem")
abort "no gem for #{version} in pkg/ (expected #{File.basename(path)})" unless File.file?(path)

package = Gem::Package.new(path)
spec_version = package.spec.version.to_s
abort "gem spec version #{spec_version} != #{version}" unless spec_version == version
names = package.contents

%w[LICENSE README.md CHANGELOG.md].each do |name|
  abort "gem missing #{name}" unless names.include?(name)
end

puts "gem ok: #{File.basename(path)}"

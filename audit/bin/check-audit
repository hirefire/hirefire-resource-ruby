#!/usr/bin/env ruby
# frozen_string_literal: true

require "json"
require_relative "../lib/results"

root = File.expand_path("../..", __dir__)
canon = ARGV.fetch(0) { abort "usage: check-audit PATH_TO_CANON_RUBY_AUDIT_DIRECTORY" }

LENSES = [
  "Logic", "Concurrency and fork", "Host safety", "Contract and integrator experience", "Adapters",
  "Architecture", "Code quality", "Performance", "Security", "Tests", "Packaging and docs"
].freeze
SEVERITIES = ["defect", "risk", "test gap", "design", "cleanup", "docs"].freeze
FIELDS = ["Location", "Lens", "Severity", "Evidence", "Proposed fix", "Behavior change"].freeze

failures = []
report = lambda do |name, problems, detail|
  puts format("%-4s %-22s %s", problems.empty? ? "PASS" : "FAIL", name, problems.empty? ? detail : problems.first(5).join(" | "))
  failures.concat(problems)
end

files = Dir.chdir(root) { Dir["lib/**/*.rb"].sort }
mapped = File.read(File.join(canon, "map.md")).scan(/^- \*\*`(lib\/[^`]+\.rb)`:\*\*/).flatten.sort
problems = []
problems << "missing from the map: #{(files - mapped).join(", ")}" unless (files - mapped).empty?
problems << "in the map but not in lib: #{(mapped - files).join(", ")}" unless (mapped - files).empty?
problems << "listed twice: #{mapped.tally.select { |_, count| count > 1 }.keys.join(", ")}" unless mapped.uniq.size == mapped.size
report.call("map", problems, "#{mapped.size} files in the map, #{files.size} under lib/")

sections = File.read(File.join(canon, "lenses.md")).split(/^## /).drop(1).to_h { |section| [section.lines.first.strip, section] }
problems = LENSES.flat_map do |lens|
  section = sections[lens] or next ["no section for #{lens}"]
  %w[Examined Method Result].reject { |label| section.match?(/^\*\*#{label}:\*\* \S/) }.map { |label| "#{lens} has no #{label}" }
end
problems.concat((sections.keys - LENSES).map { |name| "unknown lens section #{name}" })
report.call("lenses", problems, "#{LENSES.size} sections, each with Examined, Method, and Result")

text = %w[findings.md findings-design.md].map { |name| File.read(File.join(canon, name)) }.join("\n")
blocks = text.split(/^### /).drop(1)
problems = []
ranks = []
titles = {}
blocks.each_with_index do |block, index|
  heading = block.lines.first.strip
  id = heading[/\AF-(\d+): \S/, 1]
  problems << "bad heading: #{heading[0, 40]}" unless id
  problems << "#{heading[0, 5]} is out of sequence" unless id.to_i == index + 1
  titles[heading.sub(/\AF-\d+: /, "")] = "F-#{id}"
  labels = block.scan(/^- \*\*([^*]+):\*\* (.*)$/)
  problems << "#{heading[0, 5]} fields are #{labels.map(&:first).inspect}" unless labels.map(&:first) == FIELDS
  values = labels.to_h
  problems << "#{heading[0, 5]} has an empty field" if values.values.any? { |value| value.strip.empty? }
  problems << "#{heading[0, 5]} lens #{values["Lens"].inspect}" unless LENSES.include?(values["Lens"])
  problems << "#{heading[0, 5]} severity #{values["Severity"].inspect}" unless SEVERITIES.include?(values["Severity"])
  ranks << SEVERITIES.index(values["Severity"]).to_i
  locations = values["Location"].to_s.scan(/`([^`:]+):(\d+)`/)
  problems << "#{heading[0, 5]} has no file and line" if locations.empty?
  locations.each do |file, line|
    path = File.join(root, file)
    next unless file.start_with?("lib/", "test/") || File.exist?(path)

    problems << "#{heading[0, 5]} cites #{file}:#{line}, which does not exist" unless File.exist?(path) && File.foreach(path).count >= line.to_i
  end
end
problems << "severity order is not most serious first" unless ranks == ranks.sort
counts = blocks.map { |block| block[/^- \*\*Severity:\*\* (.*)$/, 1] }.tally
report.call("findings", problems, "#{blocks.size} findings, fields complete: #{SEVERITIES.map { |severity| "#{counts[severity].to_i} #{severity}" }.join(", ")}")

triage = JSON.parse(File.read(Audit.recorded("mutation/triage.json")))
records = File.readlines(Audit.recorded("mutation/mutants.jsonl")).map { |line| JSON.parse(line) }
alive = records.select { |record| %w[survived uncovered].include?(record["status"]) }.map { |record| record["id"] }
assigned = triage.fetch("groups").flat_map { |group| group.fetch("mutants").map { |mutant| mutant.fetch("id") } }
problems = []
problems << "#{(alive - assigned).size} surviving mutants are in no group" unless (alive - assigned).empty?
problems << "#{assigned.size - assigned.uniq.size} mutants are in two groups" unless assigned.uniq.size == assigned.size
triage.fetch("groups").each do |group|
  if group["verdict"] == "equivalent"
    problems << "group #{group["id"]} has no reason" if group["cause"].to_s.empty?
  elsif !titles.key?(group["finding"])
    problems << "group #{group["id"]} names a finding that is not in the list: #{group["finding"]}"
  end
end
tied = triage.fetch("groups").reject { |group| group["verdict"] == "equivalent" }.sum { |group| group["count"] }
report.call("mutation triage", problems, "#{alive.size} surviving mutants: #{tied} tied to a finding, #{alive.size - tied} marked equivalent")

diff = `git -C #{root} diff next -- lib`
report.call("lib unchanged", diff.empty? ? [] : ["git diff next -- lib is not empty"], "git diff next -- lib is empty")

exit(failures.empty? ? 0 : 1)
